# Copy to /etc/commandbridge/checkin_gateway.env (install.sh does this for you) and set mode 0640
# owned root:www-data. Never store this file under the web root or in Git.

GATEWAY_ENV=production
# Keep 0 until TLS works and the same HMAC values are set in Command Bridge.
GATEWAY_SYNC_ENABLED=0
GATEWAY_TIMEZONE=UTC

GATEWAY_DB_DSN="mysql:host=127.0.0.1;dbname=commandbridge_gateway;charset=utf8mb4"
GATEWAY_DB_USER=commandbridge_gateway
GATEWAY_DB_PASSWORD=replace_with_a_long_unique_database_password

EXTERNAL_CHECKIN_HMAC_KEY_ID=commandbridge-1
EXTERNAL_CHECKIN_HMAC_SECRET=replace_with_a_32_byte_or_longer_random_secret
# pull: the internal Command Bridge server polls this gateway (recommended; no inbound access to Command Bridge).
# push: this gateway posts to COMMANDBRIDGE_EVENTS_URL (legacy).
GATEWAY_DELIVERY_MODE=pull
GATEWAY_PULL_LEASE_SECONDS=300
# Required only for GATEWAY_DELIVERY_MODE=push.
COMMANDBRIDGE_EVENTS_URL=https://commandbridge.example.ca/api/external_checkin/v1/events.php

GATEWAY_REQUEST_TTL_SECONDS=300
GATEWAY_SESSION_IDLE_SECONDS=28800
GATEWAY_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_REQUEST_TIMEOUT_SECONDS=20
GATEWAY_MAX_ATTEMPTS=12
