# CommandBridge external check-in synchronization configuration.
# Copy this file to /etc/commandbridge/external_checkin_sync.env on the
# CommandBridge application server. Do not store the live file in the web root.
# Ownership should be the Apache/PHP service account with permissions 0600.
#
# Generate the shared secret once, transfer it securely to the gateway, and use
# the same value on both systems:
#   openssl rand -base64 48

EXTERNAL_CHECKIN_ENABLED=0
EXTERNAL_CHECKIN_GATEWAY_URL=https://checkin.example.ca/api/v1/sync/events.php
# Internal-only CommandBridge polls these public gateway endpoints for check-ins.
EXTERNAL_CHECKIN_GATEWAY_PULL_URL=https://checkin.example.ca/api/v1/sync/pull.php
EXTERNAL_CHECKIN_GATEWAY_ACK_URL=https://checkin.example.ca/api/v1/sync/ack.php
EXTERNAL_CHECKIN_HMAC_KEY_ID=commandbridge-1
EXTERNAL_CHECKIN_HMAC_SECRET=
EXTERNAL_CHECKIN_REQUEST_TTL_SECONDS=300
EXTERNAL_CHECKIN_MAX_ATTEMPTS=12
EXTERNAL_CHECKIN_CONNECT_TIMEOUT=5
EXTERNAL_CHECKIN_REQUEST_TIMEOUT=20

# Public browser destination for QR-code check-ins. Use {location_token} where
# the location's public token belongs; if omitted, location_token is appended.
EXTERNAL_CHECKIN_PUBLIC_ENTRY_BASE_URL=https://checkin.example.ca/check-in?location_token={location_token}
